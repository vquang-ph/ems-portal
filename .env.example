# Note: Use prefix APP_ for backend and APP_FRONTEND (or VITE_ - by default) for frontend environment variables

# The environment that the application is running in
APP_ENVIRONMENT=

### START DATABASE CONFIGURATION ###
# Database connection URL
APP_DATABASE_URL=

# If not using a full DATABASE_URL, individual parameters must be set
APP_DATABASE_HOST=
APP_DATABASE_PORT=
APP_DATABASE_NAME=
APP_DATABASE_USER=
APP_DATABASE_PASSWORD=
APP_DATABASE_ROOT_PASSWORD=
### END DATABASE CONFIGURATION ###

### START APPLICATION CONFIGURATION ###

# The port the Frontend Application will run on (default: 3001)
APP_FRONTEND_PORT=

# The port the Backend Application will run on (default: 3000)
APP_BACKEND_PORT=

# The URL of the Backend Application. The Frontend will reference this URL for API calls. (default: http://localhost:3000)
APP_BACKEND_URL=

# To disable or enable Swagger documentation (default: enabled)
APP_SWAGGER_ENABLED=
### END APPLICATION CONFIGURATION ###

### START AUTH CONFIGURATION ###

# Secret used to sign JWT access tokens. Use a long random string in production.
APP_JWT_SECRET=

# Access token TTL (e.g. 15m, 1h). Default: 1h
APP_JWT_ACCESS_EXPIRES_IN=

# Refresh token TTL (e.g. 7d, 30d). Default: 7d
APP_REFRESH_EXPIRES_IN=

# Cookie name used to carry the refresh token. Default: ems.refresh
APP_REFRESH_COOKIE_NAME=

# Set the refresh cookie with Secure flag (HTTPS-only). Set to "true" in prod.
APP_REFRESH_COOKIE_SECURE=

# Optional cookie domain. Leave unset in dev; set when api/app are on different subdomains.
APP_REFRESH_COOKIE_DOMAIN=

### END AUTH CONFIGURATION ###
