#!/bin/sh

# Capture staged changes relative to root
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

FRONTEND_CHANGED=$(echo "$STAGED_FILES" | grep "^packages/frontend/" || true)
BACKEND_CHANGED=$(echo "$STAGED_FILES" | grep "^packages/backend/" || true)

# Frontend Linting
if [ -n "$FRONTEND_CHANGED" ]; then
  echo "Running lint for frontend..."
  yarn workspace @ems-portal/frontend lint --max-warnings 0

  if [ $? -ne 0 ]; then
    echo "Frontend linting failed. Please fix errors before committing."
    exit 1
  fi

  echo "Running unit tests for frontend..."
  yarn workspace @ems-portal/frontend test

  if [ $? -ne 0 ]; then
    echo "Frontend unit tests failed. Please fix errors before committing."
    exit 1
  fi
fi

# Backend Linting
if [ -n "$BACKEND_CHANGED" ]; then
  echo "Running lint for backend..."
  yarn workspace @ems-portal/backend lint --max-warnings 0

  if [ $? -ne 0 ]; then
    echo "Backend linting failed. Please fix errors before committing."
    exit 1
  fi

  echo "Running unit tests for backend..."
  yarn workspace @ems-portal/backend test

  if [ $? -ne 0 ]; then
    echo "Backend unit tests failed. Please fix errors before committing."
    exit 1
  fi

  echo "Running integration tests for backend..."
  yarn workspace @ems-portal/backend test:int

  if [ $? -ne 0 ]; then
    echo "Backend integration tests failed. Please fix errors before committing."
    exit 1
  fi
fi

echo "All checks passed! Linting, unit tests, and integration tests successful!"
